{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python3:*)",
      "Bash(codex:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(uv run:*)",
      "Bash(swiftlint:*)",
      "Bash(ktlint:*)",
      "Bash(dart:*)",
      "Bash(flutter:*)",
      "Bash(playwright:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(* --no-verify)",
      "Bash(codex * --search *)",
      "Bash(codex * --dangerously-bypass-approvals-and-sandbox *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.py\"", "timeout": 5 },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pm-write-guard.py\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-gate.py\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-bash-dispatcher.py\"", "timeout": 10 }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "echo 'CRITICAL CONTEXT: Reload CLAUDE.md, AGENTS.md, .claude/docs/CODEX_TASK_CONTRACT.md, and the current task brief before continuing.'" }
        ]
      }
    ]
  }
}
