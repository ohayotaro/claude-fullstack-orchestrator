{
  "$schema": "https://claude.com/schemas/settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-4-7"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/agent-router.py" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.py" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-codex-on-contract-edit.py" }
        ]
      },
      {
        "matcher": "Read|WebFetch",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/suggest-gemini-visual.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-save.py" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/a11y-quick-check.py" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/migration-check.py" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/error-to-codex.py" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/bundle-budget-check.py" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/log-cli-tools.py" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(uv run:*)",
      "Bash(swiftlint:*)",
      "Bash(ktlint:*)",
      "Bash(dart:*)",
      "Bash(flutter:*)",
      "Bash(playwright:*)"
    ]
  },
  "mcpServers": {
    "figma-dev-mode": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp",
      "_comment": "Figma Dev Mode MCP. Enable in Figma Desktop: Preferences → Enable Dev Mode MCP Server. Requires Figma Pro/Org/Enterprise + Dev Mode access. Server starts on port 3845 by default; override the URL above if your Figma is configured differently. When this server is unreachable, /design-extract and /design-research fall back to Gemini analysis of static exports."
    }
  }
}
