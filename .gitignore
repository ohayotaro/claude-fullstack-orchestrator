.claude/tasks/*/codex-events.jsonl
.claude/state/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Env / secrets
.env
.env.local
.env.*.local
!.env.example

# Build / dependency artifacts (kept generic; per-project additions go in their own .gitignore)
node_modules/
dist/
build/
.next/
.nuxt/
.svelte-kit/
.cache/
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
DerivedData/
.gradle/
.dart_tool/

